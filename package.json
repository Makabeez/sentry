{
  "name": "sentry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir=dist --target=bun --packages=external",
    "type-check": "tsc --noEmit",
    "deploy": "lucid-deploy"
  },
  "dependencies": {
    "@lucid-agents/core": "latest",
    "@lucid-agents/hono": "latest",
    "zod": "^4.1.12",
    "@lucid-agents/http": "latest",
    "@lucid-agents/payments": "latest"
  },
  "devDependencies": {
    "bun-types": "^1.3.0",
    "typescript": "^5.9.2",
    "@lucid-agents/deploy": "latest",
    "wrangler": "4.113.0"
  }
}
